{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "旅居村换住权益领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "PROPERTY_AUTHORIZED",
        "OCCUPANCY_RESERVED",
        "OCCUPANCY_RELEASED",
        "CONTRACT_SIGNED",
        "ENTITLEMENT_GRANTED",
        "POINTS_CREDITED",
        "POINTS_DEBITED",
        "PARTY_REGISTERED",
        "RESERVATION_CONFIRMED",
        "RESERVATION_CANCELLED",
        "RESERVATION_RESCHEDULED",
        "CHECK_IN_RECORDED",
        "STAY_CHECKED_IN",
        "SERVICE_DELEGATED",
        "MAINTENANCE_BLOCKED",
        "COMPENSATION_ISSUED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "property_authorization",
        "room_calendar",
        "member_contract",
        "member_entitlement",
        "points_account",
        "travel_party",
        "stay_reservation",
        "check_in_record",
        "service_delegation",
        "maintenance_block",
        "compensation_entry"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
